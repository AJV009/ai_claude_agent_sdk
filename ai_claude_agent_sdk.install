<?php

/**
 * @file
 * Install and requirements for AI Claude Agent SDK.
 */

use Drupal\Core\Url;

/**
 * Implements hook_schema().
 */
function ai_claude_agent_sdk_schema() {
  return [];
}

/**
 * Implements hook_requirements().
 */
function ai_claude_agent_sdk_requirements($phase) {
  $requirements = [];

  if ($phase === 'runtime') {
    $config = \Drupal::config('ai_claude_agent_sdk.settings');
    $sidecar_url = $config->get('sidecar_url')
      ?: getenv('CLAUDE_SIDECAR_URL')
      ?: 'http://localhost:3000';
    $health_url = rtrim($sidecar_url, '/') . '/health';

    try {
      $client = \Drupal::httpClient();
      $response = $client->get($health_url, [
        'timeout' => 3,
        'connect_timeout' => 2,
      ]);

      if ($response->getStatusCode() === 200) {
        $data = json_decode($response->getBody()->getContents(), TRUE);
        $requirements['ai_claude_agent_sdk_sidecar'] = [
          'title' => t('Claude TUI Sidecar'),
          'value' => t('Running (v@version, @ptys active PTYs)', [
            '@version' => $data['version'] ?? 'unknown',
            '@ptys' => $data['activePTYs'] ?? '?',
          ]),
          'severity' => REQUIREMENT_OK,
        ];
      }
      else {
        $requirements['ai_claude_agent_sdk_sidecar'] = [
          'title' => t('Claude TUI Sidecar'),
          'value' => t('Unexpected response (HTTP @code)', [
            '@code' => $response->getStatusCode(),
          ]),
          'severity' => REQUIREMENT_WARNING,
        ];
      }
    }
    catch (\Exception $e) {
      $requirements['ai_claude_agent_sdk_sidecar'] = [
        'title' => t('Claude TUI Sidecar'),
        'value' => t('Not running'),
        'description' => t('The Claude TUI sidecar is not reachable at <code>@url</code>. Configure at <a href=":settings">settings</a>, or for DDEV run <code>ddev restart</code>.', [
          '@url' => $health_url,
          ':settings' => Url::fromRoute('ai_claude_agent_sdk.settings')->toString(),
        ]),
        'severity' => REQUIREMENT_WARNING,
      ];
    }
  }

  return $requirements;
}

/**
 * Add permission_timeout setting.
 */
function ai_claude_agent_sdk_update_10001() {
  $config = \Drupal::configFactory()->getEditable('ai_claude_agent_sdk.settings');
  if ($config->get('permission_timeout') === NULL) {
    $config->set('permission_timeout', 120)->save();
  }
}

/**
 * Create audit log table for tiered security system.
 */
function ai_claude_agent_sdk_update_20001() {
  $schema = ai_claude_agent_sdk_schema();
  $table = 'ai_claude_agent_sdk_audit_log';
  $db_schema = \Drupal::database()->schema();
  if (!$db_schema->tableExists($table)) {
    $db_schema->createTable($table, $schema[$table]);
  }
}

/**
 * Add site_base_url setting for policy hook callbacks.
 */
function ai_claude_agent_sdk_update_20002(): void {
  $config = \Drupal::configFactory()->getEditable('ai_claude_agent_sdk.settings');
  if ($config->get('site_base_url') === NULL) {
    $config->set('site_base_url', '')->save();
  }
}

/**
 * Drop audit log table — moved to ai_claude_agent_sdk_audit sub-module.
 */
function ai_claude_agent_sdk_update_20003(): void {
  $db_schema = \Drupal::database()->schema();
  if ($db_schema->tableExists('ai_claude_agent_sdk_audit_log')) {
    $db_schema->dropTable('ai_claude_agent_sdk_audit_log');
  }
}
