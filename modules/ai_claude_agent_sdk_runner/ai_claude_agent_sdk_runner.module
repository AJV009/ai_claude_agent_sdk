<?php

/**
 * @file
 * AI Claude Agent SDK Runner module.
 *
 * Routes AI Agent execution through Claude Code via the sidecar.
 * Handles service decoration, tool-to-skill sync, and agent form integration.
 */

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_form_alter().
 *
 * Adds bridge-enabled setting to AgentProfile forms and
 * filters the profile dropdown on AiAgent forms.
 */
function ai_claude_agent_sdk_runner_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  // --- AgentProfile forms: add bridge_enabled third-party setting ---
  if (in_array($form_id, ['agent_profile_add_form', 'agent_profile_edit_form'], TRUE)) {
    _ai_claude_agent_sdk_runner_profile_form_alter($form, $form_state);
    return;
  }

  // --- AiAgent forms: filter to bridge-enabled profiles only ---
  if (in_array($form_id, ['ai_agent_add_form', 'ai_agent_edit_form'], TRUE)) {
    _ai_claude_agent_sdk_runner_agent_form_alter($form, $form_state);
    return;
  }
}

/**
 * Adds "AI Agents Bridge" section to AgentProfile forms.
 */
function _ai_claude_agent_sdk_runner_profile_form_alter(&$form, FormStateInterface $form_state) {
  $form_object = $form_state->getFormObject();
  if (!method_exists($form_object, 'getEntity')) {
    return;
  }

  $entity = $form_object->getEntity();
  $settings = $entity->getThirdPartySetting('ai_claude_agent_sdk_runner', 'bridge', []);

  $form['runner_settings'] = [
    '#type' => 'details',
    '#title' => t('AI Agents Bridge'),
    '#description' => t(
      'When enabled, this profile can be selected as the execution engine '
      . "for AI Agent config entities. The agent's Drupal tools will be "
      . "converted to Claude Code skills within this profile's context."
    ),
    '#open' => !empty($settings['bridge_enabled']),
    '#weight' => 85,
  ];

  $form['runner_settings']['bridge_enabled'] = [
    '#type' => 'checkbox',
    '#title' => t('Available as AI Agents execution engine'),
    '#default_value' => $settings['bridge_enabled'] ?? FALSE,
  ];

  $form['actions']['submit']['#submit'][] = '_ai_claude_agent_sdk_runner_profile_form_submit';
}

/**
 * Submit handler: saves bridge_enabled as third-party setting on AgentProfile.
 */
function _ai_claude_agent_sdk_runner_profile_form_submit(array &$form, FormStateInterface $form_state) {
  $form_object = $form_state->getFormObject();
  if (!method_exists($form_object, 'getEntity')) {
    return;
  }

  $entity = $form_object->getEntity();
  $bridge_enabled = (bool) $form_state->getValue('bridge_enabled');

  $entity->setThirdPartySetting('ai_claude_agent_sdk_runner', 'bridge', [
    'bridge_enabled' => $bridge_enabled,
  ]);
  $entity->save();
}

/**
 * Returns options array of bridge-enabled AgentProfiles.
 *
 * @return array
 *   Keyed by profile ID, value is profile label.
 */
function _ai_claude_agent_sdk_runner_get_bridge_profiles(): array {
  $profile_storage = \Drupal::entityTypeManager()->getStorage('agent_profile');
  $profiles = $profile_storage->loadMultiple();
  $options = ['' => t('- Select a profile -')];

  foreach ($profiles as $profile) {
    $settings = $profile->getThirdPartySetting('ai_claude_agent_sdk_runner', 'bridge', []);
    if (!empty($settings['bridge_enabled'])) {
      $options[$profile->id()] = $profile->label();
    }
  }

  return $options;
}

/**
 * Enhances AiAgent form with Claude Code Runner settings.
 *
 * Filters profile dropdown to only bridge-enabled profiles.
 */
function _ai_claude_agent_sdk_runner_agent_form_alter(&$form, FormStateInterface $form_state) {
  $form_object = $form_state->getFormObject();
  if (!method_exists($form_object, 'getEntity')) {
    return;
  }

  $entity = $form_object->getEntity();
  $config = $entity->getThirdPartySetting('ai_claude_agent_sdk_runner', 'config', []);

  $bridge_profiles = _ai_claude_agent_sdk_runner_get_bridge_profiles();

  $form['claude_runner'] = [
    '#type' => 'details',
    '#title' => t('Claude Code Runner'),
    '#description' => t(
      "Route this agent's execution through Claude Code instead of the "
      . "built-in AI Agents ReACT loop. Claude Code handles its own "
      . "reasoning, tool use, and context management."
    ),
    '#open' => !empty($config['enabled']),
    '#weight' => 90,
  ];

  $form['claude_runner']['claude_runner_enabled'] = [
    '#type' => 'checkbox',
    '#title' => t('Use Claude Code as execution engine'),
    '#default_value' => $config['enabled'] ?? FALSE,
  ];

  $form['claude_runner']['claude_runner_profile_id'] = [
    '#type' => 'select',
    '#title' => t('Agent Profile'),
    '#description' => t(
      'Only profiles with "AI Agents Bridge" enabled appear here. '
      . 'The selected profile controls model, security tier, and execution '
      . "permissions. This agent's tools will be converted to Claude Code skills."
    ),
    '#options' => $bridge_profiles,
    '#default_value' => $config['profile_id'] ?? '',
    '#states' => [
      'visible' => [
        ':input[name="claude_runner_enabled"]' => ['checked' => TRUE],
      ],
      'required' => [
        ':input[name="claude_runner_enabled"]' => ['checked' => TRUE],
      ],
    ],
  ];

  if (count($bridge_profiles) <= 1) {
    $form['claude_runner']['no_profiles_warning'] = [
      '#type' => 'markup',
      '#markup' => '<p><em>' . t(
        'No bridge-enabled profiles found. Enable "AI Agents Bridge" on at least one Agent Profile first.'
      ) . '</em></p>',
      '#states' => [
        'visible' => [
          ':input[name="claude_runner_enabled"]' => ['checked' => TRUE],
        ],
      ],
    ];
  }

  $form['actions']['submit']['#submit'][] = '_ai_claude_agent_sdk_runner_form_submit';

  // Inject inline runner notes on existing form fields.
  _ai_claude_agent_sdk_runner_inject_field_notes($form);
  $form['#attached']['library'][] = 'ai_claude_agent_sdk_runner/runner-form-notes';
}

/**
 * Injects inline notes on AiAgent form fields about Claude Code runner behavior.
 *
 * Each note is a small markup element with #states tied to the runner toggle,
 * so notes only appear when the runner is enabled. Notes are appended to
 * existing field descriptions, not replacing them.
 */
function _ai_claude_agent_sdk_runner_inject_field_notes(array &$form): void {
  $runner_visible = [
    'visible' => [
      ':input[name="claude_runner_enabled"]' => ['checked' => TRUE],
    ],
  ];

  // --- Top-level fields ---

  // description: USED — sub-agent description.
  _ai_claude_agent_sdk_runner_append_note(
    $form['description'],
    t('Claude runner: used as this agent\'s description when delegated to as a sub-agent.'),
    $runner_visible,
    'used',
  );

  // orchestration_agent: IGNORED.
  _ai_claude_agent_sdk_runner_append_note(
    $form['orchestration_agent'],
    t('Claude runner: not used. Claude Code handles orchestration through its own agent system.'),
    $runner_visible,
  );

  // triage_agent: IGNORED.
  _ai_claude_agent_sdk_runner_append_note(
    $form['triage_agent'],
    t('Claude runner: not used. Triage decisions are handled by Claude Code internally.'),
    $runner_visible,
  );

  // max_loops: IGNORED for parent, used for sub-agents.
  _ai_claude_agent_sdk_runner_append_note(
    $form['max_loops'],
    t('Claude runner: not enforced for this agent. Used as maxTurns when this agent runs as a sub-agent.'),
    $runner_visible,
  );

  // --- prompt_detail children ---

  if (isset($form['prompt_detail'])) {
    // system_prompt: USED.
    if (isset($form['prompt_detail']['system_prompt'])) {
      _ai_claude_agent_sdk_runner_append_note(
        $form['prompt_detail']['system_prompt'],
        t('Claude runner: combined with the selected profile\'s system prompt and sent to Claude Code.'),
        $runner_visible,
        'used',
      );
    }

    // secured_system_prompt: IGNORED.
    if (isset($form['prompt_detail']['secured_system_prompt'])) {
      _ai_claude_agent_sdk_runner_append_note(
        $form['prompt_detail']['secured_system_prompt'],
        t('Claude runner: not used. The runner reads Agent Instructions directly.'),
        $runner_visible,
      );
    }

    // default_information_tools: IGNORED.
    if (isset($form['prompt_detail']['default_information_tools'])) {
      _ai_claude_agent_sdk_runner_append_note(
        $form['prompt_detail']['default_information_tools'],
        t('Claude runner: not used. Context tools are not auto-executed; Claude Code gathers context on its own.'),
        $runner_visible,
      );
    }

    // structured_output: USED.
    if (isset($form['prompt_detail']['structured_output_detail'])) {
      _ai_claude_agent_sdk_runner_append_note(
        $form['prompt_detail']['structured_output_detail'],
        t('Claude runner: translated to prompt instructions telling Claude Code to return output in the specified JSON format.'),
        $runner_visible,
        'used',
      );
    }
  }

  // --- tools_box: USED (inside prompt_detail) ---

  if (isset($form['prompt_detail']['tools_box'])) {
    _ai_claude_agent_sdk_runner_append_note(
      $form['prompt_detail']['tools_box'],
      t('Claude runner: enabled tools are converted to Claude Code skills. Sub-agent tools route through delegate-agent (ReACT) or SDK native sub-agents.'),
      $runner_visible,
      'used',
    );
  }

  // --- tool_usage: per-tool settings, MIXED (inside prompt_detail) ---

  if (isset($form['prompt_detail']['tool_usage']) && is_array($form['prompt_detail']['tool_usage'])) {
    $form['prompt_detail']['tool_usage']['_claude_runner_tool_note'] = [
      '#type' => 'container',
      '#states' => $runner_visible,
      '#weight' => -100,
      '#attributes' => ['class' => ['claude-runner-note']],
      'note' => [
        '#markup' => '<div class="claude-runner-note--ignored">'
          . t('<strong>Claude runner:</strong> '
            . '<em>Require Usage</em> and <em>Description Override</em> are translated to prompt instructions. '
            . 'All other per-tool settings (<em>Return directly</em>, <em>Use Artifacts</em>, <em>Progress Message</em>) '
            . 'and property restrictions (<em>force value</em>, <em>hide property</em>, <em>only allow</em>) '
            . 'are not enforced by the Claude Code runner.')
          . '</div>',
      ],
    ];
  }
}

/**
 * Appends a runner note to a form element's description area.
 *
 * Uses a #suffix on the element so it appears right after the field,
 * wrapped in a container with #states for conditional visibility.
 *
 * @param array $element
 *   The form element to annotate (passed by reference).
 * @param \Drupal\Core\StringTranslation\TranslatableMarkup|string $note
 *   The note text.
 * @param array $states
 *   The #states array for conditional visibility.
 * @param string $type
 *   'ignored' (default grey) or 'used' (green accent).
 */
function _ai_claude_agent_sdk_runner_append_note(array &$element, $note, array $states, string $type = 'ignored'): void {
  $class = $type === 'used' ? 'claude-runner-note--used' : 'claude-runner-note--ignored';
  // We can't use #states on #suffix directly, so we inject a child container.
  // Use a unique key to avoid collisions.
  $element['_claude_runner_note'] = [
    '#type' => 'container',
    '#states' => $states,
    '#attributes' => ['class' => ['claude-runner-note', $class]],
    '#weight' => 999,
    'note' => [
      '#markup' => '<small>' . $note . '</small>',
    ],
  ];
}

/**
 * Submit handler: saves Claude Code runner settings as third-party settings.
 */
function _ai_claude_agent_sdk_runner_form_submit(array &$form, FormStateInterface $form_state) {
  $form_object = $form_state->getFormObject();
  if (!method_exists($form_object, 'getEntity')) {
    return;
  }

  $entity = $form_object->getEntity();
  $enabled = (bool) $form_state->getValue('claude_runner_enabled');
  $profile_id = $form_state->getValue('claude_runner_profile_id') ?? '';

  $entity->setThirdPartySetting('ai_claude_agent_sdk_runner', 'config', [
    'enabled' => $enabled,
    'profile_id' => $profile_id,
  ]);
  $entity->save();
}

/**
 * Implements hook_entity_presave().
 *
 * Syncs AiAgent tools to AgentRunnerSkill entities when an AiAgent is saved.
 */
function ai_claude_agent_sdk_runner_entity_presave(EntityInterface $entity) {
  if ($entity->getEntityTypeId() !== 'ai_agent') {
    return;
  }

  $config = $entity->getThirdPartySetting('ai_claude_agent_sdk_runner', 'config', []);
  if (empty($config['enabled'])) {
    return;
  }

  $tools = $entity->get('tools') ?? [];
  if (empty($tools)) {
    return;
  }

  \Drupal::service('ai_claude_agent_sdk_runner.tool_transition_layer')
    ->syncToolsForAgent($entity->id(), $tools);
}

/**
 * Implements hook_entity_delete().
 *
 * Removes AgentRunnerSkill entities when an AiAgent is deleted.
 */
function ai_claude_agent_sdk_runner_entity_delete(EntityInterface $entity) {
  if ($entity->getEntityTypeId() !== 'ai_agent') {
    return;
  }

  \Drupal::service('ai_claude_agent_sdk_runner.tool_transition_layer')
    ->removeSkillsForAgent($entity->id());
}
