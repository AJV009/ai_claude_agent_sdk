/**
 * Create ai_claude_runner_permissions table.
 */
function ai_claude_agent_sdk_runner_update_10001() {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('ai_claude_runner_permissions')) {
    $table = ai_claude_agent_sdk_runner_schema()['ai_claude_runner_permissions'];
    $schema->createTable('ai_claude_runner_permissions', $table);
  }
