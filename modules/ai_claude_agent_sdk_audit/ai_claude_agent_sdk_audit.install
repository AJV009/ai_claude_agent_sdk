<?php

/**
 * @file
 * Install and uninstall for AI Claude Agent SDK Audit Log.
 */

/**
 * Implements hook_schema().
 */
function ai_claude_agent_sdk_audit_schema() {
  $schema['ai_claude_agent_sdk_audit_log'] = [
    'description' => 'Audit log for Claude Code security tier tool evaluations.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'Primary key.',
      ],
      'profile_id' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'description' => 'The agent profile machine name.',
      ],
      'query_id' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => '',
        'description' => 'The sidecar query ID.',
      ],
      'run_id' => [
        'type' => 'varchar',
        'length' => 255,
        'default' => '',
        'description' => 'The Drupal-assigned execution run ID.',
      ],
      'executor_uid' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'default' => 0,
        'description' => 'The Drupal user ID of the executor.',
      ],
      'tool_name' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'description' => 'The Claude Code tool name (e.g. Bash, Read, Edit).',
      ],
      'tool_input' => [
        'type' => 'text',
        'size' => 'medium',
        'description' => 'JSON-encoded tool input parameters.',
      ],
      'decision' => [
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
        'description' => 'The policy decision: allow, deny, or ask.',
      ],
      'reason' => [
        'type' => 'varchar',
        'length' => 512,
        'default' => '',
        'description' => 'Human-readable reason for the decision.',
      ],
      'tier' => [
        'type' => 'varchar',
        'length' => 32,
        'default' => '',
        'description' => 'The security tier at time of evaluation.',
      ],
      'timestamp' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'Unix timestamp of the evaluation.',
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'profile_id' => ['profile_id'],
      'query_id' => ['query_id'],
      'decision' => ['decision'],
      'timestamp' => ['timestamp'],
    ],
  ];

  return $schema;
}
